{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/check-cloud-env.mjs --build",
  "installCommand": "npx --yes pnpm@11.25.0 install --frozen-lockfile",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://nbtgvanzxbhwohpgezjj.supabase.co https://when2warn-api.onrender.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "api/statguard.py": {
      "maxDuration": 10,
      "excludeFiles": "{node_modules/**,src/**,public/**,dist/**,scripts/**,**/*.test.*,*.lock,*.yaml}"
    },
    "api/statguard_ask.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,src/**,public/**,dist/**,scripts/**,**/*.test.*,*.lock,*.yaml}"
    }
  }
}
